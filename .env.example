# BachatBuddy local environment
# Copy to backend/.env and frontend/.env.local as needed

POSTGRES_USER=bachatbuddy
POSTGRES_PASSWORD=bachatbuddy
POSTGRES_DB=bachatbuddy_development

# PostgreSQL 18 on :5432
DATABASE_URL=postgres://bachatbuddy:bachatbuddy@localhost:5432/bachatbuddy_development

REDIS_URL=redis://localhost:6379/0
JWT_SECRET=local-dev-jwt-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# Next.js frontend origin (CORS)
CORS_ORIGINS=http://localhost:3001
BCRYPT_COST=12
# Rails API port
PORT=3000

# Frontend → Rails API
NEXT_PUBLIC_API_URL=http://localhost:3000
